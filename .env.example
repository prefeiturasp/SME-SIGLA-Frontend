# URL base da API do SIGLA
# Em Docker/QA: defina no pod; o entrypoint gera public env.js (window.__ENV__).
# Local (vite): lida de import.meta.env via este arquivo.
VITE_SIGLA_API_URL=url-da-api-do-sigla

# URL base da API de admin/usuarios (login, esqueci senha, nova senha)
VITE_ADMIN_USUARIOS_API_URL=http://127.0.0.1:8005

# Path publico no browser — so vale no BUILD (npm run build / docker build).
# Local (vite na raiz): /
# QA (https://.../sigla): /sigla/
# Nao basta estar no pod em runtime: precisa de --build-arg / ENV no docker build.
VITE_BASE_PATH=/

# Redirecionamento local para ALVO/LOCUS (somente quando ENVIRONMENT=local).
# Em QA/prod deixe ENVIRONMENT vazio ou diferente de "local" para usar /alvo/ e /locus/.
ENVIRONMENT=local
ALVO_URL=http://localhost:5174/
LOCUS_URL=http://localhost:5175/
